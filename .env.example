# AshnaAI configuration for LunaAI Explorer.
#
# Copy this file to `.env` and fill in real values. Vite only exposes
# variables prefixed with VITE_ to the client build.
#
# The base URL is https://api.ashna.ai/v1/api and the OpenAI-compatible
# endpoint /chat/completions is appended automatically, so requests go to:
#   https://api.ashna.ai/v1/api/chat/completions

VITE_ASHNA_API_BASE_URL=https://api.ashna.ai/v1/api
VITE_ASHNA_API_KEY=YOUR_ASHNAAI_API_KEY
VITE_ASHNA_MODEL=ashna-x1
